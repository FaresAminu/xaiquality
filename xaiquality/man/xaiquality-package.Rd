\name{xaiquality-package}
\alias{xaiquality-package}
\alias{xaiquality}
\title{xaiquality: Statistical Quality Audits for Explainable Artificial Intelligence}
\description{The xaiquality package provides model-agnostic audits of local explanations. It combines reference-based contributions, bootstrap uncertainty, prediction-preserving stability, local fidelity, and a transparent reliability decision.}
\details{The package implements the Trustworthy Explanation Envelope (TEE) as an operational diagnostic. A \code{reliable} result is not a causal claim, a fairness guarantee, or a clinical certification.}
\author{Mohamed Amine FARES}
\seealso{\code{\link{xai_audit}}}
\keyword{package}
